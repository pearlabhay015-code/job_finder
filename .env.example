PORT=3000
APP_BASE_URL=http://localhost:3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=job_saathi
DB_USER=root
DB_PASSWORD=

CMS_ADMIN_PASSWORD=change-this-password
CMS_ADMIN_USERNAME=admin
CMS_ADMIN_EMAIL=admin@example.com
CONTACT_EMAIL=myappointers@gmail.com

# Google OAuth (create a Web application client in Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
GOOGLE_SUCCESS_URL=http://localhost:3000/index.html

# Required for sending password-reset OTP emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587

# Optional: enable live Razorpay checkout for job applications after the first free application
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
MAIL_FROM=admin@example.com
OTP_EXPIRY_MINUTES=10
ADMIN_INVITE_EXPIRY_MINUTES=30
